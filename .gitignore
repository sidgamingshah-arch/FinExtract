# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# App data (local dev)
*.db
_object_store/
finex.db

# Node / frontend (future)
node_modules/
dist/
.vite/
# The frontend is a pnpm workspace and pnpm-lock.yaml is the lockfile of record. An npm lockfile
# appears when someone falls back to `npm install` (pnpm 9 rejects this workspace file), and
# committing it alongside pnpm's would give the project two disagreeing sources of truth.
package-lock.json

# Playwright e2e artifacts
test-results/
playwright-report/
.last-run.json

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
# Lock files written next to a workbook while LibreOffice/Excel has it open. They are hidden, so
# they are easy to stage by accident from a `git add` of a directory.
.~lock.*#
~$*.xls*

# Claude Code local state + agent worktrees (never tracked)
# `.claude/*` and not `.claude/`, because git does not descend into an excluded DIRECTORY and a
# negation underneath one is therefore dead. Everything in here stays untracked...
.claude/*
# ...except the session CONFIGURATION, which has to travel with the repo to do its job. The
# session-start hook exists to put a re-provisioned container's stale clone back on the pushed
# branch; a hook that is itself untracked is wiped by the very rollback it is there to repair.
!.claude/settings.json
!.claude/dev-branch
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.sh

# Generated on demand by backend/scripts/template_output_structure.py for template review — a
# snapshot of one run's output shape, not source.
/template_output_structure.xlsx
