# Copy to `backend/.env` and fill in nothing — there is nothing secret in here.
#
# THE LLM IS NOT CONFIGURED HERE. It is defined in ONE place, `config.toml`'s `[llm]` table —
# provider, model, base_url, reasoning caps, TLS, and the NAME of the env var holding the key.
# `FINEX_LLM__*` variables are IGNORED (named in a startup WARNING), and so is anything that used
# to be saved from the Settings screen. They were removed from this file because they silently
# overrode config.toml: every run in `_run_output/` went to OpenRouter (minimax-m2.7) while
# config.toml named the CRISIL gateway.
#
# THE KEY is the one LLM thing that lives outside config.toml. Put it in the environment — or in
# `backend/.env`, which is gitignored — under the variable name `[llm].api_key_env` gives
# (shipped: LLM_GATEWAY_TOKEN — the CRISIL gateway key, sent in the `token` header):
#
#   LLM_GATEWAY_TOKEN=...
#
# A run whose provider does not resolve does NOT fail — it maps deterministically, reports far
# fewer rows, and says so only in `mapping.reason`. If a run comes out with `llm_calls: 0`, the key
# was missing.

# ── local environment ────────────────────────────────────────────────────────────────────────
# Disables torch dynamo/inductor JIT. Without it docling's layout model crashes on every scanned
# page with InvalidCxxCompiler on a machine with no MSVC toolchain.
TORCHDYNAMO_DISABLE=1

# ── what is NOT here, and where it lives instead ─────────────────────────────────────────────
# Focus routing (`llm_focus_only`, `llm_focus_keys`) is in config.toml so it travels in git, NOT
# here: `.env` is read by anything constructing Settings from this directory — pytest included —
# so focus keys set here silently reconfigured the test suite and broke
# tests/test_binding_order.py::test_a_page_the_classifier_could_not_place_is_routed_per_line.
