# Copy to `backend/.env` and fill in nothing — there is nothing secret in here.
#
# `.gitignore` excludes `.env` and admits `.env.example`, so this file is the one place a working
# provider configuration can travel with the repo. It exists because it did not: `config.toml`
# ships the CRISIL Azure gateway as the default, while every extraction recorded in `_run_output/`
# was made against OpenRouter with the settings below — which lived only in a gitignored `.env`, so
# a second machine could not reproduce them and had no way to find out why.
#
# THE KEY IS NOT HERE AND MUST NOT BE. It is read at call time from the process environment
# variable named by `FINEX_LLM__API_KEY_ENV`, so it never reaches this file, `config.toml`, the
# database or a settings export. Set it on the shell that launches the server:
#
#   $env:OPENROUTER_API_KEY = "sk-or-v1-..."          # PowerShell
#   export OPENROUTER_API_KEY=sk-or-v1-...            # bash
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
#
# A run whose provider does not resolve does NOT fail — it maps deterministically, reports far
# fewer rows, and says so only in `mapping.reason`. If a run comes out with `llm_calls: 0`, the key
# was missing from the launching shell.

# ── the provider these runs were made against ────────────────────────────────────────────────
# FINEX_* variables override config.toml (environment wins). Delete these to fall back to the
# Azure gateway config.toml ships.
FINEX_LLM__PROVIDER=openai_compatible
FINEX_LLM__BASE_URL=https://openrouter.ai/api/v1
FINEX_LLM__MODEL=minimax/minimax-m2.7:free
FINEX_LLM__API_KEY_ENV=OPENROUTER_API_KEY

# REQUIRED FOR THIS MODEL, not a tuning preference. minimax-m2.7 cannot have reasoning disabled
# ("Reasoning is mandatory for this endpoint"), and left unbounded it spends the entire completion
# budget thinking and returns empty content with finish_reason=length — a whole extraction lost.
# 3000 is the value every run in `_run_output/` used. Do not set it to 0 for this model.
FINEX_LLM__REASONING_MAX_TOKENS=3000
# Withheld deliberately: asking for reasoning EFFORT on a mapping batch competes with the JSON for
# the same budget. The cap above BOUNDS reasoning the model would do anyway; this ASKS for more.
FINEX_LLM__REASONING_EFFORT=

# Only because the corporate proxy at HTTP_PROXY intercepts TLS. Remove it on a network that does
# not, rather than carrying it as a default.
FINEX_LLM__DISABLE_SSL_VERIFY=true

# ── local environment ────────────────────────────────────────────────────────────────────────
# Disables torch dynamo/inductor JIT. Without it docling's layout model crashes on every scanned
# page with InvalidCxxCompiler on a machine with no MSVC toolchain.
TORCHDYNAMO_DISABLE=1

# ── what is NOT here, and where it lives instead ─────────────────────────────────────────────
# Focus routing (`llm_focus_only`, `llm_focus_keys`) is in config.toml so it travels in git, NOT
# here: `.env` is read by anything constructing Settings from this directory — pytest included —
# so focus keys set here silently reconfigured the test suite and broke
# tests/test_binding_order.py::test_a_page_the_classifier_could_not_place_is_routed_per_line.
