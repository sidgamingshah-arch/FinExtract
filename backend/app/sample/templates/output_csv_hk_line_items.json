 {
  "key": "is_pl__deprec_and_impairment_oper_exp",
  "label": "Deprec & Impairment (Oper Exp)",
  "type": "derived",
  "in_output": true,
  "order": 1,
  "implemented_by": "deprec_impairment",
  "description": "Depreciation charged to operating expenses. Never printed as one caption — assembled from the notes and resolved by trying the rungs in order.",
  "cascade": [
   {
    "id": "P1",
    "note": "The four operating-expense notes, summed. Any subset a filing discloses is still a sum, so each term is optional.",
    "terms": [
     {
      "ref": "sub__rd_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__selling_marketing_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__ga_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__operating_expense_depreciation",
      "sign": 1,
      "role": "any_of"
     }
    ]
   },
   {
    "id": "P2",
    "note": "The PBT note's own operating-expense callout. Already means this line, so nothing is deducted.",
    "terms": [
     {
      "ref": "sub__pbt_oper_exp_depreciation",
      "sign": 1,
      "role": "required"
     }
    ]
   },
   {
    "id": "P3",
    "note": "Total depreciation less the cost-of-sales share. A filing that discloses no cost-of-sales depreciation is taken to charge none, so the deduction is optional and the base is not.",
    "terms": [
     {
      "ref": "sub__pbt_depreciation",
      "sign": 1,
      "role": "required"
     },
     {
      "ref": "sub__cos_depreciation",
      "sign": -1,
      "role": "adjustment"
     }
    ]
   },
   {
    "id": "P4",
    "note": "The asset notes, less the cost-of-sales share.",
    "terms": [
     {
      "ref": "sub__ppe_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__prepaid_lease_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__fixed_asset_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__investment_property_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
      "ref": "sub__cip_depreciation",
      "sign": 1,
      "role": "any_of"
     },
     {
