+def _measure_slug(text: str) -> str | None:
+    """The measure a caption names: "" for the primary amount, a slug otherwise, None for a
+    caption that names no measure this reader knows."""
+    for caption, slug in _MEASURE_CAPTIONS:
+        if caption in text:
+            return slug
+    return None
